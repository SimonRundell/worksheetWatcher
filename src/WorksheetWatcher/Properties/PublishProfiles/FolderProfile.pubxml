<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!--
  Standalone single-file publish: bundles the .NET runtime and every managed/native
  dependency into one .exe, so it runs on a machine with no .NET installed and nothing
  else needs to sit next to it. The one exception is WorksheetWatcher.config.json, which
  is deliberately left as a loose file next to the exe (see the csproj) so it stays
  editable without republishing.

  Run with:
    dotnet publish src/WorksheetWatcher/WorksheetWatcher.csproj -p:PublishProfile=FolderProfile
  or Visual Studio's Publish... using this profile. Output lands in
  src/WorksheetWatcher/bin/Release/net8.0-windows/win-x64/publish/.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Suppresses the loose XML doc-comments file - useful for IntelliSense during
         development, pointless next to a shipped .exe nothing else references. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
